generator client {
  provider = "prisma-client-js"
 
}

// schema.prisma
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model Message {
  id         Int      @id @default(autoincrement())
  text       String
  senderId   Int      // just a number, not linked to User
  receiverId Int
  createdAt  DateTime @default(now())
}
